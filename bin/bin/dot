#!/usr/bin/env bash
# dot — sync the dotfiles repo and re-apply everything in one shot.
# Usage: dot [pull|brew|install|all]   (default: all)
set -euo pipefail

# This script is stowed as ~/bin/dot, a symlink into the repo's bin/bin/, so
# the repo is two levels above the link's target. $DOTFILES overrides it.
if [[ -z "${DOTFILES:-}" ]]; then
    DOTFILES="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd -P)"
fi

if [[ -z "${DOTFILES:-}" || ! -e "$DOTFILES/.git" ]]; then
    echo "error: dotfiles repo not found at $DOTFILES. Set \$DOTFILES." >&2
    exit 1
fi

step="${1:-all}"
log() { printf "\033[1;34m→\033[0m %s\n" "$*"; }

run_pull()    { log "git pull";  git -C "$DOTFILES" pull --ff-only; }
run_brew()    { log "brew bundle"; brew bundle --file="$DOTFILES/Brewfile"; }
run_install() { log "install.sh";  bash "$DOTFILES/install.sh"; }

case "$step" in
    pull)    run_pull ;;
    brew)    run_brew ;;
    install) run_install ;;
    all)     run_pull; run_install ;;  # install.sh runs brew bundle itself
    *)       echo "Usage: $(basename "$0") [pull|brew|install|all]" >&2; exit 1 ;;
esac
