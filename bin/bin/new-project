#!/usr/bin/env bash
# Scaffold a new project: mkdir, git init, .gitignore, .envrc, README.
# Usage: new-project <name> [parent-dir]   (parent defaults to ~/Developer)
set -e

if [[ $# -lt 1 ]]; then
    echo "Usage: $(basename "$0") <name> [parent-dir]" >&2
    exit 1
fi

name="$1"
parent="${2:-$HOME/Developer}"
project="$parent/$name"

if [[ -e "$project" ]]; then
    echo "error: $project already exists." >&2
    exit 1
fi

mkdir -p "$project"
cd "$project"

git init -q

cat > .gitignore <<'EOF'
.DS_Store
.env
.env.local
.envrc.local
.venv/
node_modules/
dist/
build/
*.log
EOF

cat > .envrc <<'EOF'
# direnv config. Run `direnv allow` after editing.
# layout python
# layout node
# export FOO=bar
EOF

cat > README.md <<EOF
# $name
EOF

git add .
git commit -q -m "Initial commit"

echo "Created $project"
echo "Next: cd $project && direnv allow && \$EDITOR ."
