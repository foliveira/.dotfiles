#!/usr/bin/env bash
# Start a new project: a folder with git, a .gitignore, mise.toml, fnox.toml
# and a README, and a first commit.
# Usage: new-project <name> [parent-dir]   (parent defaults to ~/Developer)
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: $(basename "$0") <name> [parent-dir]" >&2
    exit 1
fi

name="$1"
parent="${2:-$HOME/Developer}"
project="$parent/$name"

if [[ -e "$project" ]]; then
    echo "error: $project already exists." >&2
    exit 1
fi

mkdir -p "$project"
cd "$project"
git init -q

cat >.gitignore <<'END'
.DS_Store
.env
.env.local
fnox.local.toml
mise.local.toml
.venv/
node_modules/
dist/
build/
*.log
END

cat >mise.toml <<'END'
# Tools and settings for this project. mise installs them when you enter the
# folder.
[tools]
# node = "24"
# python = "3.13"
# hk = "2"

[env]
# Settings that are not secret. Secrets go in fnox.toml.
# APP_ENV = "development"

[tasks.dev]
# Runs with the secrets from fnox.toml.
# run = "fx -- nub run dev"
END

cat >fnox.toml <<'END'
# Secrets for this project, read from the 1Password Dev vault.
# Run commands that need them with:  fx -- <command>
[secrets]
# DATABASE_URL = { provider = "op", value = "My App/database-url" }
END

printf '# %s\n' "$name" >README.md

# Trust the mise.toml just written, so entering the folder doesn't complain.
command -v mise >/dev/null && mise trust -q mise.toml

git add .
git commit -q -m "chore: start project"

echo "Created $project"
echo "Next: cd $project && \$EDITOR ."
