[core]
    excludesfile = ~/.gitignore_global
    editor = nvim

[init]
    defaultBranch = master

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[branch]
    sort = -committerdate

[diff]
    algorithm = histogram
    colorMoved = default

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true

# SSH commit signing via 1Password's SSH agent.
# The signingkey itself lives in ~/.gitconfig.local.
[gpg]
    format = ssh
[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[commit]
    gpgsign = true
[tag]
    gpgsign = true
    sort = version:refname

[alias]
    co = checkout
    sw = switch
    st = status -sb
    lg = log --oneline --graph --decorate --all
    last = log -1 HEAD

# Machine-local identity and overrides, included last so they win.
[include]
    path = ~/.gitconfig.local
