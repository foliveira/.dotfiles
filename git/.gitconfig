# Git settings for the Macs. Shared settings are in ~/.config/git/common.
[include]
    path = ~/.config/git/common

[user]
    name = Fabio Oliveira
    email = foliveira@users.noreply.github.com
    # The public half of the "Github" SSH key in 1Password. The same key logs
    # in to GitHub and signs commits.
    signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPIPJxFC95REcpF0WDX2aJy5j0nyKuIQvTRV/x2qCP6B

[core]
    excludesfile = ~/.gitignore_global
    editor = nvim
    pager = delta

# delta shows diffs with syntax colours and line numbers.
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    dark = true
    line-numbers = true

# Commits and tags are signed with the SSH key in 1Password.
[gpg]
    format = ssh
[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
    # Keys trusted when checking signatures (`git log --show-signature`, `dot`).
    allowedSignersFile = ~/.config/git/allowed_signers
[commit]
    gpgsign = true
[tag]
    gpgsign = true

# Machine settings, last so they win: the private config repo, shared then
# per machine. ~/.gitconfig.local is the old place; it goes away once its
# contents move to the private repo.
[include]
    path = ~/.gitconfig.local
[include]
    path = ~/.config/local-shared/gitconfig
[include]
    path = ~/.config/local/gitconfig
