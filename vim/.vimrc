set nocompatible
syntax on
filetype plugin indent on

set number
set relativenumber
set ruler
set cursorline
set showcmd

set expandtab
set shiftwidth=4
set tabstop=4
set softtabstop=4
set autoindent

set hlsearch
set incsearch
set ignorecase
set smartcase

set hidden
set wildmenu
set wildmode=longest:full,full
set scrolloff=4
set sidescrolloff=8

set undofile
set undodir=~/.vim/undo
silent !mkdir -p ~/.vim/undo
