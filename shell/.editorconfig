# Global EditorConfig fallback. Editors that walk up the file tree pick this
# up when there's no project-level .editorconfig. A project that ships its
# own with `root = true` overrides everything below.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,go}]
indent_size = 4

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
# Markdown uses two trailing spaces for hard line breaks.
trim_trailing_whitespace = false
