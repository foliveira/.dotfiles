{
  // Theme — auto-switches with macOS appearance, matching Ghostty.
  "auto_install_extensions": { "catppuccin": true },
  "agent_servers": {
    "claude-acp": {
      "favorite_config_option_values": {
        "effort": ["max"],
        "model": ["default"],
        "mode": ["auto"],
      },
      "type": "registry",
    },
  },
  "base_keymap": "Atom",
  "theme": "Catppuccin Mocha",

  // Font — matches Ghostty/tmux for visual consistency.
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 13,

  "vim_mode": true,

  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,

  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },

  "show_whitespaces": "selection",
  "use_autoclose": true,

  "tab_size": 2,
  "soft_wrap": "editor_width",
  "preferred_line_length": 100,
  "wrap_guides": [80, 100],

  "cursor_blink": true,

  // Per-language overrides where the 2-space default isn't right.
  "languages": {
    "Python": {
      "tab_size": 4,
    },
    "Go": {
      "tab_size": 4,
      "hard_tabs": true,
    },
    "Markdown": {
      "soft_wrap": "preferred_line_length",
      "format_on_save": "off",
    },
  },
}
