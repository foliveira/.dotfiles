# Default flags applied to every rg invocation.
# Loaded via $RIPGREP_CONFIG_PATH (set in .zshrc).

--smart-case
--hidden
--follow
--max-columns=200
--max-columns-preview

# Skip folders that are never source. rg also skips what .gitignore lists,
# so build output folders are not listed here: some repos track them.
--glob=!.git/
--glob=!node_modules/
--glob=!.next/
--glob=!.nuxt/
--glob=!.venv/
--glob=!__pycache__/
--glob=!.DS_Store

# Skip lockfiles and minified output
--glob=!*.lock
--glob=!*-lock.json
--glob=!*.min.js
--glob=!*.min.css
--glob=!*.map
