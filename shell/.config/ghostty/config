# Always dark, regardless of macOS appearance.
theme = Catppuccin Mocha
window-theme = dark

# Font — Mono variant forces single-cell width on all Nerd Font glyphs.
font-family = JetBrainsMono Nerd Font Mono
font-size = 13

# Window — frameless feel with traffic lights kept, slight transparency, remember size.
macos-titlebar-style = hidden
background-opacity = 0.92
background-blur-radius = 20
window-save-state = always
window-padding-x = 10
window-padding-y = 10

# Colemak makes macOS Option type characters, so Ghostty would not send Alt.
# Left Option becomes Alt (fzf's Alt-C, zsh's Alt-b/f/.); right Option keeps accents.
macos-option-as-alt = left

# Cursor
cursor-style = bar
cursor-style-blink = true

# Behaviour
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
