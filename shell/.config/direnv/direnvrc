# Custom direnv layout helpers. Reference from project .envrc files via:
#   layout python   — project-local .venv (stdlib venv)
#   layout uv       — uv-managed .venv
#   layout node     — adds node_modules/.bin to PATH

layout_python() {
    if [[ ! -d .venv ]]; then
        log_status "creating .venv"
        python3 -m venv .venv
    fi
    source .venv/bin/activate
}

layout_uv() {
    if [[ ! -d .venv ]]; then
        log_status "creating .venv via uv"
        uv venv
    fi
    source .venv/bin/activate
}

layout_node() {
    PATH_add ./node_modules/.bin
}
