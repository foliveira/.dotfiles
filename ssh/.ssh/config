# Per-host overrides live in ~/.ssh/config.local (gitignored).
# Host-specific entries should land there, not in this file.
Include config.local

Host *
    # Route all SSH (not just git) through 1Password's SSH agent.
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    AddKeysToAgent yes

    # Connection multiplexing — reuse a single TCP connection for repeated
    # SSH/git operations to the same host within ~10 minutes.
    ControlMaster auto
    ControlPath ~/.ssh/control/%C
    ControlPersist 10m

    # Keep idle sessions alive through NAT timeouts.
    ServerAliveInterval 30
    ServerAliveCountMax 3

    # Hash hostnames in known_hosts so a leaked file doesn't reveal where
    # you've SSH'd from this machine.
    HashKnownHosts yes
