# ssh uses the FIRST value it finds for each setting, so machine settings are
# read first: the private config repo (per machine, then shared), then
# ~/.ssh/config.local, the old place, which goes away after the move.
Include ~/.config/local/ssh_config
Include ~/.config/local-shared/ssh_config
Include config.local

# Use 1Password's SSH agent when it is running. The homelab Mac has no
# 1Password, so there ssh keeps its normal agent.
Match exec "test -S '%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# GitHub: offer only the 1Password "Github" key, chosen by its public half.
# Only when 1Password runs, so the homelab Mac keeps using its own keys.
Match host github.com exec "test -S '%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
    IdentityFile ~/.ssh/github.pub
    IdentitiesOnly yes

Host *
    AddKeysToAgent yes

    # Reuse one connection for repeated SSH and git calls to the same host
    # for 10 minutes.
    ControlMaster auto
    ControlPath ~/.ssh/control/%C
    ControlPersist 10m

    # Keep idle sessions alive through NAT timeouts.
    ServerAliveInterval 30
    ServerAliveCountMax 3

    # Hash host names in known_hosts, so the file doesn't show where you
    # have connected.
    HashKnownHosts yes
